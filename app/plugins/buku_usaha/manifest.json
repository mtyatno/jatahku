    "envelopes:read",
    "transactions:read",
    "incomes:read",
    "incomes:write"
  ],
  "entities": [
    "p_buku_usaha_kontak",
    "p_buku_usaha_income_meta",
    "p_buku_usaha_txn_meta",
    "p_buku_usaha_alokasi"
  ],
  "contributes": {
