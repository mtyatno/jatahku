{
  "id": "buku_usaha",
  "name": "Buku Usaha",
  "version": "0.5.0",
  "publisher": "Jatahku",
  "description": "Pembukuan ringan untuk ruang usaha: kontak pelanggan dan pemasok, jenis pemasukan, alokasi omzet, laba rugi, dan kartu usaha di Beranda.",
  "icon": "book",
  "category": "usaha",
