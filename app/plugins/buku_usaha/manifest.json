{
  "id": "buku_usaha",
  "name": "Buku Usaha",
  "version": "0.3.0",
  "publisher": "Jatahku",
  "description": "Pembukuan ringan untuk ruang usaha: kontak pelanggan dan pemasok, jenis pemasukan, alokasi omzet, laba rugi, dan kartu usaha di Beranda.",
  "icon": "book",
  "category": "usaha",
  "engines": {
    "plugin_api": ">=1.4 <2.0"
  },
  "space_types": [
    "usaha"
  ],
  "permissions": [
    "envelopes:read",
    "transactions:read",
    "incomes:read",
    "incomes:write"
  ],
  "entities": [
    "p_buku_usaha_kontak",
    "p_buku_usaha_income_meta",
    "p_buku_usaha_txn_meta",
    "p_buku_usaha_alokasi"
  ],
  "contributes": {
    "pages": [
      {
        "route": "/p/buku_usaha",
        "title": "Buku Usaha",
        "nav": "usaha"
      }
    ],
    "quick_actions": [
      {
        "key": "buku_usaha.penjualan",
        "label": "Penjualan"
      }
    ],
    "form_fields": [
      {
        "target": "transaction",
        "key": "pemasok",
        "type": "reference",
        "entity": "p_buku_usaha_kontak",
        "label": "Pemasok"
      },
      {
        "target": "transaction",
        "key": "akun",
        "type": "select",
        "label": "Akun beban",
        "options": [
          "Bahan baku",
          "Gaji",
          "Sewa",
          "Listrik & air",
          "Transport",
          "Pemasaran",
          "Peralatan",
          "Lain-lain"
        ]
      }
    ],
    "setup": true,
    "routes": [
      {
        "method": "GET",
        "path": "/pengaturan"
      },
      {
        "method": "GET",
        "path": "/kontak"
      },
      {
        "method": "POST",
        "path": "/kontak"
      },
      {
        "method": "PATCH",
        "path": "/kontak/{id}"
      },
      {
        "method": "DELETE",
        "path": "/kontak/{id}"
      },
      {
        "method": "GET",
        "path": "/alokasi"
      },
      {
        "method": "PUT",
        "path": "/alokasi"
      },
      {
        "method": "POST",
        "path": "/penjualan/pratinjau"
      },
      {
        "method": "POST",
        "path": "/penjualan"
      },
      {
        "method": "GET",
        "path": "/laba-rugi"
      },
      {
        "method": "GET",
        "path": "/laporan"
      }
    ]
  },
  "entitlement": {
    "sku": "bundle.usaha",
    "trial_days": 30
  },
  "data_lifecycle": {
    "on_disable": "read_only",
    "on_uninstall": "archive_90_days",
    "export": [
      "csv",
      "json"
    ]
  }
}
