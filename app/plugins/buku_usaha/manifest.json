      {
        "key": "buku_usaha.omzet",
        "title": "Omzet",
        "shape": "kpi",
        "sizes": [
          "S",
          "M"
        ],
        "default": true
      },
      {
        "key": "buku_usaha.laba",
        "title": "Laba bersih",
        "shape": "kpi",
        "sizes": [
          "S",
          "M"
        ],
        "default": true
      },
      {
        "key": "buku_usaha.kas",
        "title": "Kas usaha",
        "shape": "kpi",
        "sizes": [
          "S",
          "M"
        ],
        "default": true
      },
      {
        "key": "buku_usaha.arus_kas_13",
        "title": "Arus kas 13 minggu",
        "shape": "series",
        "sizes": [
          "L",
          "XL"
        ],
        "default": true
      },
      {
        "key": "buku_usaha.alokasi_omzet",
        "title": "Alokasi omzet",
        "shape": "progress",
        "sizes": [
          "M",
          "L"
        ]
      },
      {
        "key": "buku_usaha.beban_akun",
        "title": "Beban per akun",
        "shape": "progress",
        "sizes": [
          "M",
          "L"
        ]
      },
      {
        "key": "buku_usaha.pelanggan_teratas",
        "title": "Pelanggan teratas",
        "shape": "list",
        "sizes": [
          "M",
          "L"
        ]
      },
      {
        "key": "buku_usaha.penjualan_saya",
        "title": "Penjualan saya bulan ini",
        "shape": "kpi",
        "sizes": [
          "M",
          "L"
        ],
        "default": true,
        "untuk": "karyawan"
      }
    ],
    "pages": [
      {
        "route": "/p/buku_usaha",
        "title": "Buku Usaha",
        "nav": "usaha"
      }
    ],
    "quick_actions": [
      {
        "key": "buku_usaha.penjualan",
        "label": "Penjualan"
      }
    ],
    "form_fields": [
      {
        "target": "transaction",
        "key": "pemasok",
        "type": "reference",
        "entity": "p_buku_usaha_kontak",
        "label": "Pemasok"
      },
      {
        "target": "transaction",
        "key": "akun",
        "type": "select",
        "label": "Akun beban",
        "options": [
          "Bahan baku",
          "Gaji",
          "Sewa",
          "Listrik & air",
          "Transport",
          "Pemasaran",
          "Peralatan",
          "Lain-lain"
        ]
      }
    ],
    "setup": true,
    "routes": [
      {
        "method": "GET",
        "path": "/pengaturan"
      },
      {
        "method": "GET",
        "path": "/kontak"
      },
      {
        "method": "POST",
        "path": "/kontak"
      },
      {
        "method": "PATCH",
        "path": "/kontak/{id}"
      },
      {
        "method": "DELETE",
        "path": "/kontak/{id}"
      },
      {
        "method": "GET",
        "path": "/alokasi"
      },
      {
        "method": "PUT",
        "path": "/alokasi"
      },
      {
        "method": "POST",
        "path": "/penjualan/pratinjau"
      },
      {
        "method": "POST",
        "path": "/penjualan"
      },
      {
        "method": "GET",
        "path": "/laba-rugi"
      },
      {
        "method": "GET",
        "path": "/laporan"
      }
